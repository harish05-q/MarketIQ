# ─── MarketIQ Environment Configuration ─────────────────────

# LLM Provider
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# PostgreSQL
POSTGRES_USER=marketiq
POSTGRES_PASSWORD=marketiq_pass
POSTGRES_DB=marketiq
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://marketiq:marketiq_pass@localhost:5432/marketiq

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=marketiq_articles

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=INFO

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ingestion Schedule (cron)
INGESTION_INTERVAL_SECONDS=300
BRIEFING_MORNING_HOUR=6
BRIEFING_EVENING_HOUR=18
NARRATIVE_INTERVAL_SECONDS=1800
